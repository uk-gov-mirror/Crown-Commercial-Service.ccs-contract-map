# =============================================================================
# REQUIRED: Azure OpenAI Configuration
# =============================================================================
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_KEY=<your-api-key>
DEPLOYMENT_NAME=<your-deployment-name>  # e.g., gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-01

# =============================================================================
# OPTIONAL: Redis Configuration (for caching)
# =============================================================================
# For local development with docker-compose, use: redis
# For Azure Cache for Redis with Entra ID:
# REDIS_HOST=<your-redis>.redis.cache.windows.net

# =============================================================================
# OPTIONAL: MLflow Tracking (for evaluation)
# =============================================================================
MLFLOW_TRACKING_URI=azureml://<subscription>/<resource-group>/<workspace>
MLFLOW_EXPERIMENT_NAME=ContractMap-Evaluation

# =============================================================================
# API Configuration
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=2
LOG_LEVEL=info
ENVIRONMENT=production

# Classifier Thresholds (tunable)
KEYWORD_THRESHOLD=3
KEYWORD_MARGIN=5